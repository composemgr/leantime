# Leantime Project Management - Environment Variables
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Host settings
BASE_HOST_NAME=leantime.example.com

# Database (MariaDB)
DB_CREATE_DATABASE_NAME=leantime
DB_USER_NAME=leantime
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password

# Application
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Email (SMTP)
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
